import React, { useState, useEffect, useRef } from 'react';
import { Activity, Zap, MoveRight, Expand } from 'lucide-react';

export default function App() {
  // Zustände für die Parameter
  const [laserFreq, setLaserFreq] = useState(500); // Hz
  const [wobbleFreq, setWobbleFreq] = useState(50); // Hz
  const [feedRate, setFeedRate] = useState(0.9); // m/min
  const [amplitude, setAmplitude] = useState(1.5); // mm
  const [laserMode, setLaserMode] = useState('pulsed'); // 'pulsed' oder 'cw'
  
  const canvasRef = useRef(null);

  // Physik & Canvas Parameter
  const pxPerMM = 30; // Skalierung: 30 Pixel = 1 mm
  const spotRadiusMM = 0.3; // Angenommener Fokusdurchmesser in mm
  const canvasWidthMM = 30; // Wir zeigen 30mm der Schweißnaht

  // Umrechnung: m/min zu mm/s
  // 1 m/min = 1000 mm / 60 s
  const feedRateMMS = feedRate * (1000 / 60);

  useEffect(() => {
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    const width = canvas.width;
    const height = canvas.height;
    
    // Canvas leeren und Hintergrund setzen (Sehr dunkel für starken Kontrast)
    ctx.fillStyle = '#020617'; // Slate-950
    ctx.fillRect(0, 0, width, height);

    // Raster zeichnen (1mm Schritte)
    ctx.strokeStyle = '#1e293b'; // Slate-800
    ctx.lineWidth = 1;
    for (let x = 0; x < width; x += pxPerMM) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = height / 2; y < height; y += pxPerMM) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, height - y); ctx.lineTo(width, height - y); ctx.stroke();
    }

    // Zentrum (Y-Achse)
    const yCenter = height / 2;

    // Simulation der Schweißnaht
    // Verhindere Division durch 0, falls Vorschub auf 0 gesetzt wird
    const safeFeedRateMMS = feedRateMMS > 0 ? feedRateMMS : 0.001; 
    const totalTime = canvasWidthMM / safeFeedRateMMS;
    
    if (laserMode === 'cw') {
      // CW-Modus (Kontinuierliche Linie)
      ctx.strokeStyle = '#ef4444'; // Red-500
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#dc2626'; // Red-600
      ctx.lineWidth = spotRadiusMM * 2 * pxPerMM;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      
      const steps = 1000;
      const dt = totalTime / steps;
      
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i * dt;
        const xPos = (safeFeedRateMMS * t) * pxPerMM;
        const xWobble = (amplitude * Math.cos(2 * Math.PI * wobbleFreq * t)) * pxPerMM;
        const yWobble = (amplitude * Math.sin(2 * Math.PI * wobbleFreq * t)) * pxPerMM;
        
        if (i === 0) ctx.moveTo(xPos + xWobble, yCenter + yWobble);
        else ctx.lineTo(xPos + xWobble, yCenter + yWobble);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
      
    } else {
      // Gepulster Modus (Einzelne Punkte)
      const totalPulses = Math.floor(totalTime * laserFreq);
      
      ctx.fillStyle = '#f87171'; // Red-400
      ctx.shadowBlur = 6;
      ctx.shadowColor = '#ef4444';

      for (let i = 0; i <= totalPulses; i++) {
        const t = i / laserFreq;
        if (t > totalTime) break;

        const xBase = safeFeedRateMMS * t;
        const xWobble = amplitude * Math.cos(2 * Math.PI * wobbleFreq * t);
        const yWobble = amplitude * Math.sin(2 * Math.PI * wobbleFreq * t);

        const xPx = (xBase + xWobble) * pxPerMM;
        const yPx = yCenter + (yWobble * pxPerMM);

        ctx.beginPath();
        ctx.arc(xPx, yPx, spotRadiusMM * pxPerMM, 0, 2 * Math.PI);
        ctx.fill();
      }
      ctx.shadowBlur = 0; // Reset
    }
  }, [laserFreq, wobbleFreq, feedRateMMS, amplitude, laserMode]);

  // Berechnungen für Metriken
  const pulsesPerCycle = wobbleFreq > 0 ? (laserFreq / wobbleFreq).toFixed(1) : '∞';
  
  // Überlappungsberechnung (basierend auf mm/s)
  let overlapCalc = 100 * (1 - (feedRateMMS / laserFreq) / (spotRadiusMM * 2));
  const spatialOverlap = laserMode === 'pulsed' 
    ? (overlapCalc < 0 ? 0 : overlapCalc).toFixed(0)
    : 100;

  // Helper für saubere Number-Eingaben
  const handleNumInput = (setter) => (e) => {
    const val = parseFloat(e.target.value);
    if (!isNaN(val)) setter(val);
  };

  return (
    <div className="flex flex-col md:flex-row gap-6 p-6 bg-slate-950 min-h-screen font-sans text-slate-200">
      
      {/* Sidebar Controls */}
      <div className="w-full md:w-1/3 bg-slate-900 p-6 rounded-xl shadow-lg border border-slate-800">
        <h2 className="text-xl font-bold mb-6 text-slate-100 border-b border-slate-800 pb-2">Schweiß-Parameter</h2>
        
        <div className="mb-6">
          <label className="block text-sm font-semibold mb-2 text-slate-300">Lasermodus</label>
          <div className="flex gap-2">
            <button 
              onClick={() => setLaserMode('pulsed')}
              className={`flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-colors border ${laserMode === 'pulsed' ? 'bg-blue-600 border-blue-500 text-white' : 'bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-700'}`}
            >
              Gepulst (Pulsed)
            </button>
            <button 
              onClick={() => setLaserMode('cw')}
              className={`flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-colors border ${laserMode === 'cw' ? 'bg-blue-600 border-blue-500 text-white' : 'bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-700'}`}
            >
              Dauerstrich (CW)
            </button>
          </div>
        </div>

        {/* Laser Freq */}
        <div className={`mb-6 transition-opacity ${laserMode === 'cw' ? 'opacity-30 pointer-events-none' : 'opacity-100'}`}>
          <div className="flex justify-between items-center mb-2">
            <label className="text-sm font-semibold flex items-center gap-2 text-slate-300"><Zap size={16} className="text-yellow-400"/> Laser-Frequenz</label>
            <div className="flex items-center gap-2">
              <input 
                type="number" value={laserFreq} onChange={handleNumInput(setLaserFreq)}
                className="w-20 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right focus:outline-none focus:border-blue-500 text-sm"
              />
              <span className="text-xs text-slate-500 font-mono w-4">Hz</span>
            </div>
          </div>
          <input 
            type="range" min="100" max="2000" step="10" 
            value={laserFreq} onChange={(e) => setLaserFreq(Number(e.target.value))}
            className="w-full accent-blue-500"
          />
        </div>

        {/* Wobble Freq */}
        <div className="mb-6">
          <div className="flex justify-between items-center mb-2">
            <label className="text-sm font-semibold flex items-center gap-2 text-slate-300"><Activity size={16} className="text-green-400"/> Wobble-Frequenz</label>
            <div className="flex items-center gap-2">
              <input 
                type="number" value={wobbleFreq} onChange={handleNumInput(setWobbleFreq)}
                className="w-20 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right focus:outline-none focus:border-blue-500 text-sm"
              />
              <span className="text-xs text-slate-500 font-mono w-4">Hz</span>
            </div>
          </div>
          <input 
            type="range" min="10" max="300" step="5" 
            value={wobbleFreq} onChange={(e) => setWobbleFreq(Number(e.target.value))}
            className="w-full accent-blue-500"
          />
        </div>

        {/* Feed Rate */}
        <div className="mb-6">
          <div className="flex justify-between items-center mb-2">
            <label className="text-sm font-semibold flex items-center gap-2 text-slate-300"><MoveRight size={16} className="text-blue-400"/> Vorschub</label>
            <div className="flex items-center gap-2">
              <input 
                type="number" step="0.1" value={feedRate} onChange={handleNumInput(setFeedRate)}
                className="w-20 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right focus:outline-none focus:border-blue-500 text-sm"
              />
              <span className="text-xs text-slate-500 font-mono w-8">m/min</span>
            </div>
          </div>
          <input 
            type="range" min="0.1" max="6.0" step="0.1" 
            value={feedRate} onChange={(e) => setFeedRate(Number(e.target.value))}
            className="w-full accent-blue-500"
          />
          <div className="text-right mt-1">
             <span className="text-xs text-slate-600">entspricht {feedRateMMS.toFixed(1)} mm/s</span>
          </div>
        </div>

        {/* Amplitude */}
        <div className="mb-6">
          <div className="flex justify-between items-center mb-2">
            <label className="text-sm font-semibold flex items-center gap-2 text-slate-300"><Expand size={16} className="text-purple-400"/> Amplitude</label>
            <div className="flex items-center gap-2">
              <input 
                type="number" step="0.1" value={amplitude} onChange={handleNumInput(setAmplitude)}
                className="w-20 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right focus:outline-none focus:border-blue-500 text-sm"
              />
              <span className="text-xs text-slate-500 font-mono w-4">mm</span>
            </div>
          </div>
          <input 
            type="range" min="0" max="5" step="0.1" 
            value={amplitude} onChange={(e) => setAmplitude(Number(e.target.value))}
            className="w-full accent-blue-500"
          />
        </div>
      </div>

      {/* Visualisierung & Metriken */}
      <div className="w-full md:w-2/3 flex flex-col gap-4">
        
        {/* Metriken Dashboard */}
        <div className="grid grid-cols-2 gap-4">
          <div className="bg-slate-900 p-4 rounded-xl border border-slate-800 shadow-sm flex flex-col justify-center items-center">
            <span className="text-slate-400 text-sm font-medium mb-1">Pulse pro Zyklus</span>
            <span className="text-2xl font-bold text-slate-100">
              {laserMode === 'cw' ? '∞' : pulsesPerCycle}
            </span>
            <span className="text-xs text-slate-600 mt-1 text-center">Laser Hz ÷ Wobble Hz</span>
          </div>
          <div className="bg-slate-900 p-4 rounded-xl border border-slate-800 shadow-sm flex flex-col justify-center items-center">
            <span className="text-slate-400 text-sm font-medium mb-1">Linearer Überlapp</span>
            <span className="text-2xl font-bold text-slate-100">
              {laserMode === 'cw' ? '100' : spatialOverlap}%
            </span>
            <span className="text-xs text-slate-600 mt-1 text-center">Bei Fokus-Ø 0.6mm (Theoretisch)</span>
          </div>
        </div>

        {/* Canvas Area */}
        <div className="bg-slate-900 rounded-xl shadow-lg border border-slate-800 overflow-hidden flex-grow flex flex-col">
          <div className="p-4 border-b border-slate-800 bg-slate-900/50 flex justify-between items-center">
            <h3 className="font-semibold text-slate-200">Schweißnaht-Simulation</h3>
            <span className="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded border border-slate-700">Ansicht: 30 mm</span>
          </div>
          <div className="p-4 flex-grow flex items-center justify-center bg-[#020617]">
            <canvas 
              ref={canvasRef} 
              width={900} 
              height={300} 
              className="max-w-full h-auto rounded border border-slate-800 shadow-2xl"
              style={{ width: '100%', maxWidth: '900px' }}
            />
          </div>
        </div>
        
        {/* Erklärungsbox */}
        <div className="bg-blue-900/20 p-4 rounded-xl border border-blue-900/50 text-sm text-blue-300">
          <strong className="text-blue-400">Tipp:</strong> Probiere aus, die Vorschubgeschwindigkeit (z.B. auf 6 m/min) hochzustellen und die Wobble-Frequenz zu senken (z.B. 20 Hz). Du siehst dann sehr deutlich die Zykloiden-Kurve, die der Scanner abfährt.
        </div>
      </div>

    </div>
  );
}


